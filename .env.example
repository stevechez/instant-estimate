# Copy to .env.local and fill in. For local dev, run `supabase start` and
# copy the ANON_KEY / SERVICE_ROLE_KEY it prints (or `supabase status -o env`).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key for AI service classification in the estimate widget.
OPENAI_API_KEY=

# SMTP for lead notification emails. Point at the local Mailpit relay for
# dev (host 127.0.0.1, port 54325, no auth — see supabase/config.toml
# [local_smtp]), or a real transactional email provider's SMTP endpoint in
# production (Resend, Postmark, SES, ...).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Base URL used to build links in notification emails/SMS (e.g. https://app.example.com).
APP_URL=

# Twilio, for SMS lead notifications (optional — additive to the required
# email notification; a business with no notification_phone set just
# doesn't get texted). Unset or missing any of these and SMS is silently
# skipped, not an error.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sentry, for error monitoring (optional). Sentry.init() safely no-ops with
# no DSN, so leaving these unset just means errors aren't reported anywhere.
# NEXT_PUBLIC_SENTRY_DSN is the same DSN for client, server, and edge.
# SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only needed to enable
# source map upload at build time (next.config.ts skips that step entirely
# when SENTRY_AUTH_TOKEN is unset).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
