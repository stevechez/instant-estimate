# Copy to .env.local and fill in. For local dev, run `supabase start` and
# copy the ANON_KEY / SERVICE_ROLE_KEY it prints (or `supabase status -o env`).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
